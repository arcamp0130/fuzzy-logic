{
  "name": "fuzzy-logic",
  "version": "0.0.1",
  "description": "Implementation of fuzzy logic to take decisions based on fuzzy inference.",
  "keywords": [
    "fuzzy",
    "inference",
    "fuzzy-logic"
  ],
  "homepage": "https://github.com/arcamp0130/fuzzy-logic#readme",
  "bugs": {
    "url": "https://github.com/arcamp0130/fuzzy-logic/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcamp0130/fuzzy-logic.git"
  },
  "license": "ISC",
  "author": "Arath Campos",
  "type": "module",
  "main": "./src/server/index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
